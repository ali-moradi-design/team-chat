# Copy to .env — every value has a sensible development default.
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/team-chat
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required in production (>= 16 chars, ideally 32+ random bytes)
# JWT_SECRET=

# Files
UPLOAD_DIR=./uploads
MAX_FILE_BYTES=10485760

# Socket.IO Redis adapter (several server instances). Optional.
# REDIS_URL=redis://127.0.0.1:6379

# Demo: passwordless demo accounts, a bot, nightly reset at 03:00 UTC
# DEMO_MODE=true
# DEMO_BOT=true

# Behind a reverse proxy
# TRUST_PROXY=true
# COOKIE_SECURE=true
